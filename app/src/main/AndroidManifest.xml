<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Sandbox and Guest App Host Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".VirtualApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@null"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.VirtualSandbox"
        android:requestLegacyExternalStorage="true"
        tools:targetApi="34">

        <!-- Host Management Main UI Activity -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.VirtualSandbox">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Pre-registered Stub Activities across Multi-Processes (:virtual_p0 to :virtual_p9) -->
        <activity
            android:name=".stub.StubActivity$P0"
            android:exported="false"
            android:process=":virtual_p0"
            android:configChanges="mcc|mnc|locale|touchscreen|keyboard|keyboardHidden|navigation|screenLayout|fontScale|uiMode|orientation|screenSize|smallestScreenSize"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".stub.StubActivity$P1"
            android:exported="false"
            android:process=":virtual_p1"
            android:configChanges="mcc|mnc|locale|touchscreen|keyboard|keyboardHidden|navigation|screenLayout|fontScale|uiMode|orientation|screenSize|smallestScreenSize"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".stub.StubActivity$P2"
            android:exported="false"
            android:process=":virtual_p2"
            android:configChanges="mcc|mnc|locale|touchscreen|keyboard|keyboardHidden|navigation|screenLayout|fontScale|uiMode|orientation|screenSize|smallestScreenSize"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".stub.StubActivity$P3"
            android:exported="false"
            android:process=":virtual_p3"
            android:configChanges="mcc|mnc|locale|touchscreen|keyboard|keyboardHidden|navigation|screenLayout|fontScale|uiMode|orientation|screenSize|smallestScreenSize"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".stub.StubActivity$P4"
            android:exported="false"
            android:process=":virtual_p4"
            android:configChanges="mcc|mnc|locale|touchscreen|keyboard|keyboardHidden|navigation|screenLayout|fontScale|uiMode|orientation|screenSize|smallestScreenSize"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".stub.StubActivity$P5"
            android:exported="false"
            android:process=":virtual_p5"
            android:configChanges="mcc|mnc|locale|touchscreen|keyboard|keyboardHidden|navigation|screenLayout|fontScale|uiMode|orientation|screenSize|smallestScreenSize"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".stub.StubActivity$P6"
            android:exported="false"
            android:process=":virtual_p6"
            android:configChanges="mcc|mnc|locale|touchscreen|keyboard|keyboardHidden|navigation|screenLayout|fontScale|uiMode|orientation|screenSize|smallestScreenSize"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".stub.StubActivity$P7"
            android:exported="false"
            android:process=":virtual_p7"
            android:configChanges="mcc|mnc|locale|touchscreen|keyboard|keyboardHidden|navigation|screenLayout|fontScale|uiMode|orientation|screenSize|smallestScreenSize"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".stub.StubActivity$P8"
            android:exported="false"
            android:process=":virtual_p8"
            android:configChanges="mcc|mnc|locale|touchscreen|keyboard|keyboardHidden|navigation|screenLayout|fontScale|uiMode|orientation|screenSize|smallestScreenSize"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".stub.StubActivity$P9"
            android:exported="false"
            android:process=":virtual_p9"
            android:configChanges="mcc|mnc|locale|touchscreen|keyboard|keyboardHidden|navigation|screenLayout|fontScale|uiMode|orientation|screenSize|smallestScreenSize"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize" />

        <!-- Pre-registered Stub Services across Multi-Processes -->
        <service
            android:name=".stub.StubService$P0"
            android:exported="false"
            android:process=":virtual_p0" />

        <service
            android:name=".stub.StubService$P1"
            android:exported="false"
            android:process=":virtual_p1" />

        <service
            android:name=".stub.StubService$P2"
            android:exported="false"
            android:process=":virtual_p2" />

        <service
            android:name=".stub.StubService$P3"
            android:exported="false"
            android:process=":virtual_p3" />

        <service
            android:name=".stub.StubService$P4"
            android:exported="false"
            android:process=":virtual_p4" />

        <!-- Pre-registered Stub Content Providers -->
        <provider
            android:name=".stub.StubContentProvider$P0"
            android:authorities="${applicationId}.stub.provider_p0"
            android:exported="false"
            android:process=":virtual_p0" />

        <provider
            android:name=".stub.StubContentProvider$P1"
            android:authorities="${applicationId}.stub.provider_p1"
            android:exported="false"
            android:process=":virtual_p1" />

        <!-- Stub Broadcast Receiver -->
        <receiver
            android:name=".stub.StubReceiver"
            android:exported="false" />

        <!-- File Provider for APK and Sandbox Sharing -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
